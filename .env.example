# Used by `npm run config` (scripts/build-config.mjs) to write assets/js/config.js
# at deploy time — set these in Netlify / Vercel / Cloudflare Pages settings.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SHOW_DEMO_DATA=false
MAP_CENTER_LAT=5.6037
MAP_CENTER_LNG=-0.187
MAP_ZOOM=16
SITE_URL=https://greencampusinnovation.com

# Server-side only. Never referenced by the website. Listed so nobody adds it by mistake.
# SUPABASE_SERVICE_ROLE_KEY=  <-- do NOT set this in the hosting build environment
