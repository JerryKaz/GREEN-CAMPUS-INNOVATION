# Secrets: never commit real keys
.env
.env.*
!.env.example

# Dependencies and tooling
node_modules/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build and deploy output
_site/
dist/
build/
.netlify/
.vercel/
.wrangler/

# Large media: keep originals out of Git; commit web-ready photos only.
# Videos belong on YouTube or Google Drive, never in the repository.
public/images/**/originals/
public/videos/**/*.*
!public/videos/**/.gitkeep
*.mp4
*.mov
*.MOV
*.avi
*.mkv

# Editors and operating systems
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# Logs, coverage, archives
*.log
coverage/
*.zip
